---
import CliPrefix from "../components/CliPrefix.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main id="container">
		<CliPrefix useCaret={true}>
			<p>where am I?</p>
		</CliPrefix>

		<section class="content">
			<h1>404: Not Found</h1>
			<p>
				The page you requested does not exist, was moved, or the URL was typed
				incorrectly.
			</p>
			<a href="/" aria-label="Go back to homepage">cd ~</a>
		</section>
	</main>
</Layout>

<style>
	#container {
		max-width: 80ch;
		height: 100%;
		padding: 24px;
		overflow: hidden;
    color: #e9e9f4;
	}

	.content {
		margin-top: 16px;
		display: grid;
		gap: 16px;
	}

	h1 {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.3;
	}

	p {
		margin: 0;
		line-height: 1.6;
	}

	a {
		display: inline-block;
		width: fit-content;
		margin-top: 8px;
		padding: 8px 12px;
		border: 1px solid #f7f;
		color: #f7f;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	a:hover,
	a:focus-visible {
		background-color: #f7f;
		color: #211925;
	}
</style>
