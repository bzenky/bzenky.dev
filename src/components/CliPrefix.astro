---
import Caret from "./Caret.astro";
const { useCaret = false } = Astro.props;
---

<div class="cli-prefix-container">
  <span class="cli-prefix">bzenky<span class="host">@bruno</span></span>
  <span class="directory">~</span>
  <span class="dollar-sign" aria-hidden="true">$</span>
  <span class="command"><slot />{useCaret && <Caret />}</span>
</div>

<style>
  .cli-prefix-container { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75ch; font-size: inherit; }
  .cli-prefix { color: var(--purple); }
  .host { color: var(--muted); }
  .directory { color: var(--cyan); }
  .dollar-sign { color: var(--pink); }
  .command { display: inline-flex; align-items: center; gap: 0.5ch; color: var(--text); }
  .command :global(p) { margin: 0; }
  @media (max-width: 420px) { .host { display: none; } }
</style>
