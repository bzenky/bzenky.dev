    .suggestions button, .run { color: var(--cyan); border: 0; border-radius: 0; background: transparent; padding: 0; min-height: 2em; }
    button:hover { color: var(--purple); text-decoration: underline; }
    @media (pointer: coarse) {
        .run { display: inline-block; min-height: 44px; }
        .suggestions button, .output :global(a), .output :global(button) { min-height: 44px; }
    }
    @media (max-width: 420px) { .host { display: none; } }
</style>
