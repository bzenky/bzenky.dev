    .output :global(.file-list) { display: flex; flex-wrap: wrap; gap: 0 2ch; }
    form { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.75ch; }
    label { flex-shrink: 0; }
    .prompt-user { color: var(--purple); }
    .host { color: var(--muted); }
    .directory { color: var(--cyan); }
    .prompt-dollar { color: var(--pink); }
    .command-line { position: relative; flex: 1 1 6ch; min-width: 0; overflow: hidden; }
    input { display: block; width: 100%; min-width: 0; min-height: 44px; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--text); font-size: 1rem; caret-color: transparent; }
    .caret-measure { position: absolute; visibility: hidden; white-space: pre; pointer-events: none; }
    .block-caret { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 1ch; height: 1.15em; line-height: 1.15; white-space: pre; overflow: hidden; background: var(--cursor); color: var(--cursor-text); pointer-events: none; animation: blink 1.4s ease-in-out infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    input:focus-visible { outline: none; }
    form:focus-within .prompt-dollar { color: var(--mint); }
    .run { display: none; }
