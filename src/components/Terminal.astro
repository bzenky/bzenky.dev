<section class="terminal" aria-label="Interactive terminal" hidden data-terminal>
    <div class="suggestions" id="terminal-hint" role="group" aria-label="Suggested commands">
        <span># try:</span>
        {['help', 'about', 'experience', 'projects', 'links', 'contact', 'yotei', 'theme', 'clear'].map(command => <button type="button" data-command={command}>{command}</button>)}
    </div>
    <div class="output" role="log" aria-label="Command output" aria-live="polite" aria-relevant="additions" tabindex="0" data-output></div>
    <form autocomplete="off" data-command-form>
        <label for="terminal-command"><span class="prompt-user">bzenky<span class="host">@bruno</span></span> <span class="directory">~</span> <span class="prompt-dollar">$</span><span class="sr-only">Terminal command</span></label>
        <div class="command-line">
            <input id="terminal-command" name="command" type="text" aria-describedby="terminal-hint" autocapitalize="off" spellcheck="false" maxlength="120" enterkeyhint="send" />
            <span class="caret-measure" aria-hidden="true" data-caret-measure></span>
            <span class="block-caret" aria-hidden="true" data-block-caret></span>
        </div>
        <button class="run" type="submit" aria-label="[enter] Run command">[enter]</button>
    </form>
</section>

<script>
    import { bio } from '../data/bio';
    import { education, experience, projects, type Entry } from '../data/background';
    import { suggestCommand } from '../lib/command-suggestions';

    const terminal = document.querySelector<HTMLElement>('[data-terminal]');
    const form = document.querySelector<HTMLFormElement>('[data-command-form]');
    const input = document.querySelector<HTMLInputElement>('#terminal-command');
    const output = document.querySelector<HTMLElement>('[data-output]');

    if (terminal && form && input && output) {
        terminal.hidden = false;
        const history: string[] = [];
        let historyCount = 0;
        let historyIndex = 0;
        let draft = '';
        const caret = terminal.querySelector<HTMLElement>('[data-block-caret]');
        const measure = terminal.querySelector<HTMLElement>('[data-caret-measure]');

        function syncCaret() {
            if (!input || !caret || !measure) return;
            measure.textContent = input.value.slice(0, input.selectionStart ?? input.value.length);
            const offset = measure.getBoundingClientRect().width - input.scrollLeft;
            const maxOffset = Math.max(0, input.clientWidth - caret.getBoundingClientRect().width);
            caret.style.left = `${Math.max(0, Math.min(offset, maxOffset))}px`;
            caret.textContent = [...input.value.slice(input.selectionStart ?? input.value.length)][0] ?? ' ';
            caret.hidden = input.selectionStart !== input.selectionEnd;
        }

        const queueCaret = () => requestAnimationFrame(syncCaret);
        for (const event of ['input', 'select', 'keyup', 'click', 'scroll', 'focus', 'blur']) {
            input.addEventListener(event, queueCaret);
        }
        document.addEventListener('selectionchange', () => {
            if (document.activeElement === input) queueCaret();
        });
        new ResizeObserver(queueCaret).observe(input);
        document.fonts.ready.then(syncCaret);
        syncCaret();

        document.addEventListener('click', event => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            if (target.closest('a, button, input, textarea, select, label, [contenteditable], [role="button"], .mountain')) return;
            if (window.getSelection()?.toString()) return;
            input.focus();
        });

        const main = terminal.closest('main');
        const focusOnLoad = () => {
            if (!matchMedia('(pointer: fine)').matches) return;
            if (document.activeElement && document.activeElement !== document.body) return;
            input.focus({ preventScroll: true });
        };
        if (main?.hasAttribute('data-booting')) {
            const observer = new MutationObserver(() => {
                if (main.hasAttribute('data-booting')) return;
                observer.disconnect();
                focusOnLoad();
            });
            observer.observe(main, { attributes: true, attributeFilter: ['data-booting'] });
        } else {
            focusOnLoad();
        }

        const replies: Record<string, string> = {
            help: 'about · a little about me\nexperience · where I’ve worked\neducation · where I studied\nprojects · things I’ve made\nneofetch · me, at a glance\nlinks · find me online\ncontact · say hello\nyotei · my theme\ntheme · choose Yotei, Midnight, or Dawn\ntheme <variant> · switch and remember your choice\ndate · what time it is for me\nopen · pick a site to open\nopen <site> · open github, linkedin, youtube, or yotei\ncopy email · copy my email address\nhistory · show previous commands\nclear · clear this terminal\n\nUse ↑ / ↓ for history and !! to repeat the last command. Tab completes a command. Ctrl+C cancels, Ctrl+L clears the screen.',
            about: 'Bruno Asano · software developer from Brazil.\nReact, JavaScript, Node.js & Ruby on Rails.\nI like solving problems and making things useful.',
            whoami: 'You’re a welcome visitor. Make yourself at home.',
            pwd: '/home/bzenky — you’re in the right place.',
        };
        const linkReplies: Record<string, { label: string; url: string }[]> = {
            links: [
                { label: 'GitHub ↗', url: 'https://github.com/bzenky' },
                { label: 'LinkedIn ↗', url: 'https://www.linkedin.com/in/bzenky' },
                { label: 'YouTube ↗', url: 'https://www.youtube.com/@_zenky' },
            ],
            contact: [{ label: 'bzenky@gmail.com', url: 'mailto:bzenky@gmail.com' }],
            yotei: [{ label: 'Yotei — my purple-red dawn theme ↗', url: 'https://github.com/bzenky/yotei' }],
        };
        const themes = { yotei: 'Yotei', midnight: 'Yotei Midnight', dawn: 'Yotei Dawn' };
        const hiddenReplies: Record<string, string> = {
            'cd ..': 'There’s no place like ~.',
            'rm -rf /': 'Nice try. I just got this place looking good.',
            'ping bruno': 'pong 🇧🇷',
            'git blame': 'It was like that when I got here.',
            vim: 'You’re in. Good luck getting out.',
            vi: 'You’re in. Good luck getting out.',
            nvim: 'You’re in. Good luck getting out.',
            ':q': 'Thanks, I was worried about you.',
            ':q!': 'Thanks, I was worried about you.',
            ':wq': 'Thanks, I was worried about you.',
            'git push --force': 'Bold. I respect it.',
            'git push -f': 'Bold. I respect it.',
        };
        const sites: Record<string, { label: string; url: string }> = {
            github: { label: 'GitHub', url: 'https://github.com/bzenky' },
            linkedin: { label: 'LinkedIn', url: 'https://www.linkedin.com/in/bzenky' },
            youtube: { label: 'YouTube', url: 'https://www.youtube.com/@_zenky' },
            yotei: { label: 'Yotei', url: 'https://yotei.bzenky.dev' },
        };
        const email = 'bzenky@gmail.com';
        const fileCommands: Record<string, string> = {
            'cat about.txt': 'full-about',
            './links.sh': 'links',
            'cat yotei.conf': 'yotei',
        };
        const sections: Record<string, Entry[]> = { experience, education, projects };
        const commands = [...Object.keys(replies), ...Object.keys(linkReplies), ...Object.keys(sections), 'neofetch', 'date', 'copy email', ...Object.keys(sites).map(site => `open ${site}`), 'history', 'clear', 'theme', ...Object.keys(themes).map(theme => `theme ${theme}`)];

        function newTabLink(label: string, url: string) {
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = `${label} ↗`;
            return link;
        }

        function entryList(entries: Entry[]) {
            const list = document.createElement('div');
            list.className = entries.some(({ notes }) => notes?.length) ? 'entries spaced' : 'entries';
            for (const { title, place, detail, notes = [] } of entries) {
                const item = document.createElement('div');
                const header = document.createElement('div');
                const role = document.createElement('span');
                role.className = 'role';
                role.textContent = title;
                header.append(role, ' · ', newTabLink(place.label, place.url), ` · ${detail}`);
                item.append(header);
                for (const note of notes) {
                    const bullet = document.createElement('div');
                    bullet.className = 'note';
                    bullet.textContent = `- ${note}`;
                    item.append(bullet);
                }
                list.append(item);
            }
            return list;
        }

        function clearTerminal() {
            output?.replaceChildren();
            const initialOutput = document.querySelector<HTMLElement>('[data-initial-output]');
            if (initialOutput) initialOutput.hidden = true;
        }

        type Theme = keyof typeof themes;
        const KONAMI = '↑↑↓↓←→←→BA';
        const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

        function applyTheme(theme: Theme) {
            document.documentElement.dataset.theme = theme;
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--background').trim());
            document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(button => {
                button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
            });
        }

        function setTheme(theme: Theme) {
            stopSunrise();
            applyTheme(theme);
            try { localStorage.setItem('yotei-theme', theme); } catch {}
        }

        let sunriseTimers: number[] = [];
        let sunriseFrom: Theme | undefined;
        function stopSunrise() {
            sunriseTimers.forEach(clearTimeout);
            sunriseTimers = [];
            sunriseFrom = undefined;
            delete document.documentElement.dataset.sunrise;
        }
        function sunrise() {
            const from = sunriseFrom ?? (document.documentElement.dataset.theme ?? 'yotei') as Theme;
            stopSunrise();
            sunriseFrom = from;
            document.documentElement.dataset.sunrise = '';
            const step = 1400;
            const steps: Theme[] = ['midnight', 'dawn', from];
            steps.forEach((theme, index) => {
                sunriseTimers.push(window.setTimeout(() => applyTheme(theme), index * step));
            });
            sunriseTimers.push(window.setTimeout(() => {
                stopSunrise();
                applyTheme(from);
            }, steps.length * step));
        }

        type Draw = (context: CanvasRenderingContext2D, opacity: number) => void;
        let overlayActive = false;
        // Full-screen canvas over the page for 5s, fading out over the last second.
        function playOverlay(setup: (width: number, height: number) => Draw) {
            if (overlayActive) return;
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            if (!context) return;
            overlayActive = true;
            canvas.setAttribute('aria-hidden', 'true');
            canvas.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:10';
            const width = innerWidth;
            const height = innerHeight;
            const ratio = devicePixelRatio || 1;
            canvas.width = width * ratio;
            canvas.height = height * ratio;
            context.scale(ratio, ratio);
            document.body.append(canvas);
            const draw = setup(width, height);
            const duration = 5000;
            const fade = 1000;
            const start = performance.now();

            function frame(now: number) {
                if (!context) return;
                const elapsed = now - start;
                if (elapsed > duration) {
                    canvas.remove();
                    overlayActive = false;
                    return;
                }
                context.clearRect(0, 0, width, height);
                draw(context, Math.min(1, (duration - elapsed) / fade));
                requestAnimationFrame(frame);
            }
            requestAnimationFrame(frame);
        }

        const themeColor = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

        function rain() {
            playOverlay((width, height) => {
                const size = 16;
                const trail = 14;
                const head = themeColor('--text');
                const colors = ['--purple', '--pink', '--cyan'].map(themeColor);
                const glyphs = 'ヨテイアイウエオカキクケコサシスセソ01<>/{}$#';
                const columns = Array.from({ length: Math.ceil(width / size) }, () => ({
                    y: -Math.random() * (height / size),
                    speed: 0.25 + Math.random() * 0.45,
                    color: colors[Math.floor(Math.random() * colors.length)] ?? head,
                }));
                return (context, opacity) => {
                    context.font = `${size}px "JetBrains Mono", monospace`;
                    context.textBaseline = 'top';
                    columns.forEach((column, index) => {
                        column.y += column.speed;
                        if (column.y - trail > height / size) column.y = -Math.random() * 10;
                        const top = Math.floor(column.y);
                        for (let step = 0; step < trail; step++) {
                            const row = top - step;
                            if (row < 0) continue;
                            context.globalAlpha = opacity * (1 - step / trail);
                            context.fillStyle = step === 0 ? head : column.color;
                            context.fillText(glyphs[(index * 31 + row * 17) % glyphs.length] ?? '', index * size, row * size);
                        }
                    });
                };
            });
        }

        function snow() {
            playOverlay((width, height) => {
                const color = themeColor('--text');
                const flakes = Array.from({ length: Math.min(220, Math.round(width / 7)) }, () => ({
                    x: Math.random() * width,
                    y: -Math.random() * height,
                    radius: 1 + Math.random() * 2.2,
                    speed: 0.4 + Math.random() * 1.1,
                    phase: Math.random() * Math.PI * 2,
                }));
                return (context, opacity) => {
                    context.fillStyle = color;
                    for (const flake of flakes) {
                        flake.y += flake.speed;
                        flake.phase += 0.02;
                        flake.x += Math.sin(flake.phase) * 0.4;
                        if (flake.y > height + 4) {
                            flake.y = -4;
                            flake.x = Math.random() * width;
                        }
                        context.globalAlpha = opacity * (0.45 + flake.radius / 6);
                        context.beginPath();
                        context.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
                        context.fill();
                    }
                };
            });
        }

        function mountain() {
            const art = document.createElement('pre');
            art.className = 'mountain';
            art.setAttribute('role', 'img');
            art.setAttribute('aria-label', 'ASCII Mount Yotei beneath a dawn sky');
            const lines = [
                '    .        *',
                '         .',
                "        /\\",
                "       /  \\",
                "      / /\\ \\",
                "     / /  \\ \\",
                "    /_/____\\_\\",
                '  ~~~~~~~~~~~~~~',
                '     Y O T E I',
            ];
            for (const [index, line] of lines.entries()) {
                const row = document.createElement('span');
                row.style.color = index < 2 ? 'var(--pink)' : index < 7 ? 'var(--purple)' : 'var(--cyan)';
                row.textContent = `${line}\n`;
                art.append(row);
            }
            // Touch stand-in for the Konami code: tap the mountain five times.
            let taps = 0;
            let tapTimer = 0;
            art.addEventListener('click', () => {
                clearTimeout(tapTimer);
                tapTimer = window.setTimeout(() => { taps = 0; }, 1500);
                if (++taps < 5) return;
                taps = 0;
                run(KONAMI);
            });
            return art;
        }

        function neofetch() {
            const card = document.createElement('div');
            card.className = 'neofetch';
            const info = document.createElement('p');
            const user = document.createElement('span');
            user.className = 'prompt-user';
            user.textContent = 'bzenky';
            const host = document.createElement('span');
            host.className = 'host';
            host.textContent = '@bruno';
            info.append(user, host, '\n------------\n');
            const theme = (document.documentElement.dataset.theme ?? 'yotei') as Theme;
            const fields = [
                ['os', 'Brazil 🇧🇷'],
                ['uptime', '5+ years building for the web'],
                ['stack', 'React · JavaScript · Node.js · Rails'],
                ['work', 'SaaS for qualitative & quantitative research'],
                ['shell', 'zsh (Oh My Zsh)'],
                ['editor', 'T3 Code / Orca'],
                ['terminal', 'kitty / Windows Terminal'],
                ['theme', themes[theme] ?? themes.yotei],
                ['font', 'JetBrains Mono'],
            ];
            for (const [key, text] of fields) {
                const label = document.createElement('span');
                label.className = 'key';
                label.textContent = `${key}: `;
                info.append(label, `${text}\n`);
            }
            const swatches = document.createElement('span');
            swatches.className = 'swatches';
            swatches.setAttribute('aria-hidden', 'true');
            for (const color of ['text', 'purple', 'pink', 'cyan', 'mint', 'muted']) {
                const swatch = document.createElement('span');
                swatch.style.background = `var(--${color})`;
                swatches.append(swatch);
            }
            info.append('\n', swatches);
            card.append(mountain(), info);
            return card;
        }

        const between = (min: number, max: number) => min + Math.floor(Math.random() * (max - min + 1));

        function processList() {
            const processes = [
                { pid: 1, name: 'coffee', cpu: between(88, 99), mem: between(8, 16) },
                { pid: 42, name: 'side-projects', cpu: between(20, 75), mem: between(15, 45) },
                { pid: 127, name: 'learning', cpu: between(30, 85), mem: between(35, 70) },
                { pid: 404, name: 'debugging', cpu: between(5, 90), mem: between(5, 40) },
                { pid: 1337, name: 'yotei-theme', cpu: between(3, 20), mem: between(2, 8) },
                { pid: 2077, name: 'sleep', cpu: 0, mem: 0 },
            ].sort((a, b) => b.cpu - a.cpu);
            const rows = processes.map(({ pid, name, cpu, mem }) =>
                `${String(pid).padStart(5)}  ${name.padEnd(14)}  ${`${cpu}%`.padStart(4)}  ${`${mem}%`.padStart(4)}`);
            return ['  PID  PROCESS          CPU   MEM', ...rows].join('\n');
        }

        function npmInstall() {
            const added = between(120, 2400);
            const audited = added + between(1, 60);
            const seconds = (between(2, 300) / 10).toFixed(1);
            const summary = `added ${added.toLocaleString('en-US')} packages, and audited ${audited.toLocaleString('en-US')} packages in ${seconds}s`;
            if (Math.random() < 0.7) return `${summary}\n\n0 vulnerabilities (this time)`;
            const moderate = between(1, 9);
            const high = between(0, 4);
            return `${summary}\n\n${moderate + high} vulnerabilities (${moderate} moderate, ${high} high)\n\nTo address all issues, run:\n  npm audit fix`;
        }

        const notFound = [
            (value: string) => `Command not found: ${value}. `,
            (value: string) => `bzenky: ${value}: command not found. `,
            (value: string) => `“${value}”? Never heard of it. `,
            (value: string) => `I looked everywhere. No ${value} here. `,
            (value: string) => `${value} isn’t installed. Yet. `,
        ];
        let lastNotFound = -1;
        function notFoundMessage(value: string) {
            let index = Math.floor(Math.random() * notFound.length);
            if (index === lastNotFound) index = (index + 1) % notFound.length;
            lastNotFound = index;
            return notFound[index]?.(value) ?? `Command not found: ${value}. `;
        }

        function brazilTime() {
            const now = new Date();
            const timeZone = 'America/Sao_Paulo';
            const day = new Intl.DateTimeFormat('en-GB', { timeZone, weekday: 'short', day: 'numeric', month: 'short' }).format(now);
            const time = new Intl.DateTimeFormat('en-GB', { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(now);
            return `${day} · ${time} in Brazil (BRT, UTC−3)`;
        }

        function newEntry(typed: string) {
            const entry = document.createElement('div');
            entry.className = 'entry';
            const prompt = document.createElement('p');
            prompt.className = 'echo';
            prompt.textContent = `bzenky@bruno ~ $ ${typed}`;
            entry.append(prompt);
            return entry;
        }

        function addEntry(entry: HTMLElement) {
            output?.append(entry);
            if (output && output.children.length > 20) output.firstElementChild?.remove();
            form?.scrollIntoView({ block: 'nearest' });
        }

        function resetInput() {
            if (!input) return;
            input.value = '';
            historyIndex = history.length;
            draft = '';
            queueCaret();
        }

        // Bash-style history expansion: !! is the last command, !n is entry n of `history`.
        function expandHistory(value: string) {
            if (value === '!!') return history.at(-1);
            if (/^!\d+$/.test(value)) return history[Number(value.slice(1)) - (historyCount - history.length) - 1];
            return value;
        }

        function run(raw: string) {
            const typed = raw.trim();
            if (!typed || !output || !input) return;
            const value = expandHistory(typed);
            if (!value) {
                resetInput();
                const entry = newEntry(typed);
                const reply = document.createElement('p');
                reply.textContent = `bzenky: ${typed}: event not found`;
                entry.append(reply);
                addEntry(entry);
                return;
            }
            history.push(value);
            historyCount++;
            if (history.length > 50) history.shift();
            resetInput();
            const normalized = value.toLowerCase();
            const command = Object.hasOwn(fileCommands, normalized) ? fileCommands[normalized] ?? normalized : normalized;
            if (command === 'clear') {
                clearTerminal();
                return;
            }
            const entry = newEntry(typed);
            if (value !== typed) {
                const expanded = document.createElement('p');
                expanded.textContent = value;
                entry.append(expanded);
            }
            const reply = document.createElement('p');
            const [name, variant, ...extra] = command.split(/\s+/);
            if (command === 'ls') {
                reply.className = 'file-list';
                for (const fileCommand of Object.keys(fileCommands)) {
                    const filename = fileCommand.replace(/^(cat |\.\/)/, '');
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.textContent = filename;
                    button.title = fileCommand;
                    button.dataset.fileCommand = fileCommand;
                    button.setAttribute('aria-label', `${fileCommand.startsWith('./') ? 'Run' : 'Read'} ${filename}`);
                    button.addEventListener('click', () => {
                        run(fileCommand);
                        input?.focus();
                    });
                    reply.append(button);
                }
            } else if (command === 'history') {
                reply.textContent = history.map((item, index) => `${historyCount - history.length + index + 1}  ${item}`).join('\n');
            } else if (command === 'full-about') {
                reply.textContent = bio.join('\n\n');
            } else if (Object.hasOwn(sections, command)) {
                entry.append(entryList(sections[command] ?? []));            } else if (command === 'cat yotei') {
                entry.append(mountain());
            } else if (command === KONAMI.toLowerCase()) {
                entry.append(mountain());
                reply.textContent = 'Cheat code accepted. You reached the summit.';
            } else if (command === 'neofetch') {
                entry.append(neofetch());
            } else if (name === 'npm' && (variant === 'install' || variant === 'i')) {
                reply.textContent = npmInstall();
            } else if (name === 'echo') {
                reply.textContent = value.slice(4).trim();
            } else if (command === 'date') {
                reply.textContent = brazilTime();
            } else if (name === 'sudo') {
                reply.textContent = 'bzenky is not in the sudoers file. This incident will be reported.';
            } else if (command === 'sunrise') {
                if (reducedMotion()) {
                    reply.textContent = 'Sunrise skipped: reduced motion is on. Try “theme dawn”.';
                } else {
                    reply.textContent = 'The sun is coming up over Yōtei…';
                    sunrise();
                }
            } else if (command === 'matrix') {
                if (reducedMotion()) {
                    reply.textContent = 'Follow the white rabbit. (The rain is off: reduced motion is on.)';
                } else {
                    reply.textContent = 'Follow the white rabbit.';
                    rain();
                }
            } else if (command === 'snow') {
                if (reducedMotion()) {
                    reply.textContent = 'It’s snowing on Yōtei. (The snow is off: reduced motion is on.)';
                } else {
                    reply.textContent = 'It’s snowing on Yōtei.';
                    snow();
                }
            } else if (command === 'top' || command === 'htop') {
                reply.textContent = processList();
            } else if (name === 'copy' && variant !== 'email') {
                const target = value.slice(4).trim();
                reply.textContent = target ? `I can’t copy “${target}”. Try “copy email”.` : 'Copy what? Try “copy email”.';
            } else if (command === 'copy email') {
                const failed = () => { reply.textContent = `Couldn’t reach your clipboard. Here it is: ${email}`; };
                if (navigator.clipboard) {
                    reply.textContent = 'Copying…';
                    navigator.clipboard.writeText(email)
                        .then(() => { reply.textContent = `Copied ${email} to your clipboard.`; })
                        .catch(failed);
                } else {
                    failed();
                }
            } else if (name === 'open') {
                const site = variant && extra.length === 0 ? sites[variant] : undefined;
                if (site) {
                    reply.append(`Opening `, newTabLink(site.label, site.url), '…');
                    window.open(site.url, '_blank', 'noopener');
                } else if (!variant) {
                    reply.textContent = 'Open: ';
                    for (const [id, { label }] of Object.entries(sites)) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.textContent = label;
                        button.addEventListener('click', () => {
                            run(`open ${id}`);
                            input?.focus();
                        });
                        reply.append(button, ' ');
                    }
                } else {
                    reply.textContent = `Usage: open [${Object.keys(sites).join(' | ')}]`;
                }
            } else if (Object.hasOwn(hiddenReplies, command)) {
                reply.textContent = hiddenReplies[command] ?? '';
            } else if (name === 'cd') {
                const target = value.slice(2).trim();
                reply.textContent = !target || target === '~' ? 'You’re already home.' : `${target}: no such directory. Everything I have is right here in ~.`;
            } else if (name === 'ssh') {
                reply.textContent = 'Connection refused. You’re already where you need to be.';
            } else if (name === 'theme') {
                if (variant) {
                    if (Object.hasOwn(themes, variant) && extra.length === 0) {
                        const theme = variant as keyof typeof themes;
                        setTheme(theme);
                        reply.textContent = `Theme: ${themes[theme]}.`;
                    } else {
                        reply.textContent = 'Usage: theme [yotei | midnight | dawn]';
                    }
                } else {
                    reply.textContent = 'Choose a theme: ';
                    for (const [id, label] of Object.entries(themes)) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.dataset.themeChoice = id;
                        button.textContent = label;
                        button.setAttribute('aria-pressed', String((document.documentElement.dataset.theme ?? 'yotei') === id));
                        button.addEventListener('click', () => {
                            setTheme(id as keyof typeof themes);
                            input?.focus();
                        });
                        reply.append(button, document.createTextNode(' '));
                    }
                }
            } else if (Object.hasOwn(linkReplies, command)) {
                for (const { label, url } of linkReplies[command] ?? []) {
                    const link = document.createElement('a');
                    link.href = url;
                    link.textContent = label;
                    if (url.startsWith('https:')) {
                        link.target = '_blank';
                        link.rel = 'noopener noreferrer';
                    }
                    reply.append(link, document.createElement('br'));
                }
            } else {
                if (Object.hasOwn(replies, command)) {
                    reply.textContent = replies[command] ?? '';
                } else {
                    const suggestion = suggestCommand(normalized, commands);
                    reply.textContent = notFoundMessage(value);
                    if (suggestion) {
                        reply.append('Did you mean ');
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.textContent = suggestion;
                        button.addEventListener('click', () => {
                            run(suggestion);
                            input?.focus();
                        });
                        reply.append(button, '?');
                    } else {
                        reply.append('Try “help”.');
                    }
                }
            }
            entry.append(reply);
            addEntry(entry);
        }

        form.addEventListener('submit', event => {
            event.preventDefault();
            run(input.value);
            input.focus();
        });
        terminal.querySelectorAll<HTMLButtonElement>('[data-command]').forEach(button => {
            button.addEventListener('click', () => {
                run(button.dataset.command ?? '');
                input.focus();
            });
        });
        input.addEventListener('keydown', event => {
            if (event.ctrlKey && !event.altKey && !event.metaKey && event.key.toLowerCase() === 'l') {
                event.preventDefault();
                clearTerminal();
            } else if (event.ctrlKey && !event.altKey && !event.metaKey && event.key.toLowerCase() === 'c' && input.selectionStart === input.selectionEnd) {
                // Only when nothing is selected, so Ctrl+C still copies a selection.
                event.preventDefault();
                addEntry(newEntry(`${input.value}^C`));
                resetInput();
            } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
                event.preventDefault();
                if (historyIndex === history.length) draft = input.value;
                historyIndex = Math.max(0, Math.min(history.length, historyIndex + (event.key === 'ArrowUp' ? -1 : 1)));
                input.value = history[historyIndex] ?? draft;
            } else if (event.key === 'Tab' && input.value.trim()) {
                const matches = commands.filter(command => command.startsWith(input.value.trim().toLowerCase()));
                if (matches.length === 1 && matches[0] !== input.value) {
                    event.preventDefault();
                    input.value = matches[0] ?? '';
                }
            } else if (event.key === 'Escape') {
                input.value = '';
            }
            queueCaret();
        });

        const pageTitle = document.title;
        document.addEventListener('visibilitychange', () => {
            document.title = document.hidden ? 'come back ~ $' : pageTitle;
        });

        console.log(
            '%cbzenky@bruno ~ $ %cLooking under the hood? Say hi → type “contact” in the terminal.',
            'color:#de71ff;font-family:monospace;font-weight:bold',
            'color:#62d6e8;font-family:monospace',
        );

        const konamiKeys = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
        let recentKeys: string[] = [];
        document.addEventListener('keydown', event => {
            recentKeys = [...recentKeys, event.key.length === 1 ? event.key.toLowerCase() : event.key].slice(-konamiKeys.length);
            if (recentKeys.join() !== konamiKeys.join()) return;
            recentKeys = [];
            event.preventDefault();
            run(KONAMI);
            input.focus();
        });
    }
</script>

