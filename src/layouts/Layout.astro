---
const title = "Bruno Asano · Software Developer";
const description = "Software developer from Brazil building for the web with React, JavaScript, Node.js and Ruby on Rails. Problem solver who cares about reliable, useful software.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="preconnect" href="https://www.google-analytics.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">
		<link rel="dns-prefetch" href="https://www.google-analytics.com">
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="bzenky.dev" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:secure_url" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Bruno Asano — software developer from Brazil, shown in a terminal window" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="theme-color" content="#222230" />
		<script is:inline>
			(() => {
				const backgrounds = { yotei: '#222230', midnight: '#120d15', dawn: '#fff7fb' };
				let theme = 'yotei';
				try {
					const saved = localStorage.getItem('yotei-theme');
					if (Object.hasOwn(backgrounds, saved)) theme = saved;
				} catch {}
				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]').content = backgrounds[theme];
			})();
		</script>
		<title>{title}</title>

		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-YBMX40KKW0"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-YBMX40KKW0");
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Yotei: github.com/bzenky/yotei/blob/master/kitty/yotei.conf */
		--background: #222230;
		--surface: #222230;
		--surface-raised: #282936;
		--border: #4d4352;
		--text: #e9e9f4;
		--muted: #b0abc1;
		--purple: #de71ff;
		--pink: #ea51b2;
		--cyan: #62d6e8;
		--mint: #a1efe4;
		--selection: #44475a;
		--selection-text: #f2f2f2;
		--cursor: #e9e9f4;
		--cursor-text: #222230;
		color-scheme: dark;
		font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
		font-synthesis: none;
		background: var(--background);
		color: var(--text);
	}

	:root[data-theme="midnight"] {
		--background: #120d15;
		--surface: #120d15;
		--surface-raised: #0f0a12;
		--border: #2f2635;
		--cursor-text: #120d15;
	}

	:root[data-theme="dawn"] {
		--background: #fff7fb;
		--surface: #f7eaf3;
		--surface-raised: #f2ddeb;
		--border: #e9c6dd;
		--text: #35263d;
		--muted: #7a687f;
		--purple: #8117c7;
		--pink: #b13a85;
		--cyan: #256d85;
		--mint: #347f73;
		--selection: #e8c4f4;
		--selection-text: #35263d;
		--cursor: #35263d;
		--cursor-text: #fff7fb;
		color-scheme: light;
	}

	*, *::before, *::after { box-sizing: border-box; }
	body { margin: 0; font-size: 1rem; line-height: 1.7; }
	::selection { background: var(--selection); color: var(--selection-text); }
	a { color: var(--cyan); text-underline-offset: 5px; }
	a:hover { color: var(--purple); }
	a, button { transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease; }
	button, input { font: inherit; }
	button { cursor: pointer; }
	:focus-visible { outline: 2px solid var(--cyan); outline-offset: 5px; }
	p { margin: 0 0 1.25rem; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	[hidden] { display: none !important; }

	/* Registered as colors so `sunrise` can animate between themes. */
	@property --background { syntax: '<color>'; inherits: true; initial-value: #222230; }
	@property --surface { syntax: '<color>'; inherits: true; initial-value: #222230; }
	@property --surface-raised { syntax: '<color>'; inherits: true; initial-value: #282936; }
	@property --border { syntax: '<color>'; inherits: true; initial-value: #4d4352; }
	@property --text { syntax: '<color>'; inherits: true; initial-value: #e9e9f4; }
	@property --muted { syntax: '<color>'; inherits: true; initial-value: #b0abc1; }
	@property --purple { syntax: '<color>'; inherits: true; initial-value: #de71ff; }
	@property --pink { syntax: '<color>'; inherits: true; initial-value: #ea51b2; }
	@property --cyan { syntax: '<color>'; inherits: true; initial-value: #62d6e8; }
	@property --mint { syntax: '<color>'; inherits: true; initial-value: #a1efe4; }
	@property --cursor { syntax: '<color>'; inherits: true; initial-value: #e9e9f4; }
	@property --cursor-text { syntax: '<color>'; inherits: true; initial-value: #222230; }
	:root[data-sunrise] {
		--sunrise-ease: 1s ease-in-out;
		transition: --background var(--sunrise-ease), --surface var(--sunrise-ease), --surface-raised var(--sunrise-ease), --border var(--sunrise-ease), --text var(--sunrise-ease), --muted var(--sunrise-ease), --purple var(--sunrise-ease), --pink var(--sunrise-ease), --cyan var(--sunrise-ease), --mint var(--sunrise-ease), --cursor var(--sunrise-ease), --cursor-text var(--sunrise-ease);
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
	}
</style>
